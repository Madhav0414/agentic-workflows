# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=your-anthropic-api-key
PERPLEXITY_API_KEY=your-perplexity-api-key

# Gmail delivery uses OAuth files instead of .env:
#   credentials.json  — OAuth client (Google Cloud Console → Desktop app)
#   token.json        — created automatically on first authorized send
# Napkin.ai uses a saved browser session (tools/setup_napkin_session.py), no key needed.
